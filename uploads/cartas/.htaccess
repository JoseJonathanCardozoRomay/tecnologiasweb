# Carta de designacion: los PDF solo se sirven a traves de
# /controllers/carta_pdf.php, que valida existencia, propiedad e integridad
# del archivo antes de emitirlo. Se bloquea todo acceso HTTP directo al
# directorio; el backend lee el archivo en disco, no pasa por Apache.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Defensa en profundidad: ningun script ejecutable dentro de esta carpeta.
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes
